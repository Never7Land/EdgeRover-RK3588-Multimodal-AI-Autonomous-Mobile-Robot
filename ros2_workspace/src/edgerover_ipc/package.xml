  <version>0.1.0</version> <!-- 功能包版本 -->
  <description>Shared-memory IPC for EdgeRover (FrameRing)</description> <!-- 功能包功能描述 -->

  <maintainer email="lyfan@todo.todo">lyfan</maintainer> <!-- 维护者及邮箱 -->
  <license>Apache-2.0</license> <!-- 开源许可证 -->

  <buildtool_depend>ament_cmake</buildtool_depend> <!-- 指定使用 ament_cmake 作为构建工具 -->

  <export>
